+// Returns the given towner's fixed town tile, or `fallback` if that towner
+// isn't present this game (Towners is populated from InitTowners(), already
+// called earlier in the same town-load sequence RttEnsureTownServiceObjects()
+// runs in - see LoadGameLevelTown() in diablo.cpp).
+Point RttFindTownerPosition(_talker_id type, Point fallback)
+{
+	for (const Towner &towner : Towners) {
+		if (towner._ttype == type)
+			return towner.position;
+	}
+	return fallback;
+}
