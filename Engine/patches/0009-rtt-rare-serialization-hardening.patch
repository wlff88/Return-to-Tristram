+
+bool IsRttPrefixCode(uint8_t code)
+{
+	return code >= 1 && code <= 6;
+}
+
+bool IsRttSuffixCode(uint8_t code)
+{
+	return code >= 7 && code <= 12;
+}
+
+int RttAffixMinItemLevel(uint8_t code)
+{
+	if (code < 1 || code > 12)
+		return CF_LEVEL + 1;
+	const uint8_t tier = static_cast<uint8_t>((code - 1) % 3);
+	return tier == 0 ? 1 : tier == 1 ? 10 : 20;
+}
+
+bool IsRttAffixCompatible(const Item &item, uint8_t code, size_t slot, int itemLevel)
+{
+	if (code == 0)
+		return true;
+	if (slot >= RttAffixMasks.size())
+		return false;
+
+	const bool prefixSlot = slot < 2;
+	if (prefixSlot ? !IsRttPrefixCode(code) : !IsRttSuffixCode(code))
+		return false;
+	if (itemLevel < RttAffixMinItemLevel(code))
+		return false;
+
+	if (code <= 3)
+		return item.isWeapon();
+	if (code <= 6)
+		return item.isArmor() || item.isShield() || item.isHelm();
+	return code <= 12 && item.isEquipment();
 }
 
