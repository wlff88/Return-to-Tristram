+bool RttWarpToLevel(Player &player, uint8_t level)
+{
+    // Mirrors the vanilla town-warp entrances in Source/levels/trigs.cpp (which
+    // gate on pTownWarps per dungeon *branch*): RTT waypoints extend that to
+    // per-level granularity using the already-persisted, already-multiplayer-
+    // safe _pLvlVisited[] array instead of adding new save state. Warping is
+    // only offered from town, matching where the vanilla entrances live.
+    if (&player != MyPlayer || level < 1 || level > 16) return false;
+    if (!player.isOnLevel(0)) return false;
+    if (!player._pLvlVisited[level]) return false;
+    StartNewLvl(player, WM_DIABTOWNWARP, level);
+    return true;
+}
