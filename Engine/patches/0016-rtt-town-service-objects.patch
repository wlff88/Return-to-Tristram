+namespace {
+// _oVar3 is untouched by both AddChest() (uses _oVar1/_oVar2) and
+// AddWeaponRack() (uses only _oAnimFlag/selectionRegion/_oRndSeed), so it is
+// free for both object types; the two sentinels never need to differ since
+// _otype is checked alongside it.
+constexpr int RttTownServiceSentinel = 1;
+
+bool IsRttStashChest(const Object &object)
+{
+	return object._otype == OBJ_CHEST1 && object._oVar3 == RttTownServiceSentinel;
+}
+
+bool IsRttCraftingAnchor(const Object &object)
+{
+	return object._otype == OBJ_WEAPONRACK && object._oVar3 == RttTownServiceSentinel;
+}
+
+void RttPlaceTownServiceObject(Point anchor, _object_id type)
+{
+	for (int i = 0; i < ActiveObjectCount; ++i) {
+		const Object &existing = Objects[ActiveObjects[i]];
+		if (existing._otype == type && existing._oVar3 == RttTownServiceSentinel)
+			return;
+	}
+
+	// A wider offset set than the waypoint's own: by the time this runs the
+	// waypoint circle may already occupy the nearest tiles, and now two more
+	// objects are competing for space around the same anchor.
+	static constexpr std::array<Displacement, 12> Offsets {
+		Displacement { 2, 0 }, Displacement { 0, 2 }, Displacement { -2, 0 },
+		Displacement { 0, -2 }, Displacement { 1, 1 }, Displacement { -1, 1 },
+		Displacement { 1, -1 }, Displacement { -1, -1 }, Displacement { 3, 0 },
+		Displacement { 0, 3 }, Displacement { -3, 0 }, Displacement { 0, -3 }
+	};
+
+	for (const Displacement &offset : Offsets) {
+		const Point candidate = anchor + offset;
+		if (!InDungeonBounds(candidate))
+			continue;
+		if (IsTileSolid(candidate) || IsObjectAtPosition(candidate))
+			continue;
+		Object *object = AddObject(type, candidate);
+		if (object == nullptr)
+			return;
+		object->_oVar3 = RttTownServiceSentinel;
+		if (type == OBJ_WEAPONRACK) {
+			// AddWeaponRack() conditionally clears selectionRegion based on
+			// the dungeon theme-generation global `weaponFlag`, which is
+			// meaningless in town and left over from whichever dungeon
+			// level was last generated. Force this instance clickable
+			// regardless of that stale state.
+			object->selectionRegion = SelectionRegion::Bottom | SelectionRegion::Middle;
+		}
+		return;
+	}
+}
+} // namespace
+
+void RttEnsureTownServiceObjects(Point anchor)
+{
+	if (currlevel != 0)
+		return;
+	RttPlaceTownServiceObject(anchor, OBJ_CHEST1);
+	RttPlaceTownServiceObject(anchor, OBJ_WEAPONRACK);
+}
