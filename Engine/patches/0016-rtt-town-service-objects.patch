+TEST_F(RttPhase4, EnsureTownServiceObjectsNoOpOffTown)
+{
+    // RttEnsureTownServiceObjects() (the physical stash chest and crafting
+    // anchor) is town-only; it must short-circuit on any dungeon level
+    // without touching object state, for the same reason as the waypoint
+    // equivalent above -- dungeon levels 1-16 have no generated layout here.
+    const uint8_t savedLevel = currlevel;
+    const int activeBefore = ActiveObjectCount;
+    currlevel = 3;
+    RttEnsureTownServiceObjects({ 0, 0 });
+    EXPECT_EQ(ActiveObjectCount, activeBefore);
+    currlevel = savedLevel;
+}
