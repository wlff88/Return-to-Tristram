+// Tier I recipes (5-7) work on Normal/Magic items (no RTT metadata yet) by re-running
+// the SAME deterministic SetupAllItems()/RecreateItem() pipeline every drop/load/network
+// item already goes through, just with a new seed derived from the target's own seed -
+// never a bespoke generator. Recipe 7 (Reroll Affix Value) additionally rejects any
+// candidate whose affix *type* (_iPrePower/_iSufPower) differs from the original, so only
+// the rolled value changes - bounded rejection sampling, not a new mutation primitive.
+bool RttPrepareTierOneCraft(const Player &player, const Item &target, unsigned recipe, Item &result)
+{
+    if (HasRttItemMetadata(target)) return false; // Rare/Set/Unique use recipes 2/3/4/8 instead
+    if (recipe == 5 && target._iMagical != ITEM_QUALITY_NORMAL) return false;
+    if ((recipe == 6 || recipe == 7) && target._iMagical != ITEM_QUALITY_MAGIC) return false;
+
+    const int level = target._iCreateInfo & CF_LEVEL;
+    int uper = 0;
+    if ((target._iCreateInfo & CF_UPER1) != 0) uper = 1;
+    if ((target._iCreateInfo & CF_UPER15) != 0) uper = 15;
+    const bool pregen = (target._iCreateInfo & CF_PREGEN) != 0;
+
+    constexpr int MaxAttempts = 64;
+    for (int attempt = 1; attempt <= MaxAttempts; ++attempt) {
+        const uint32_t newSeed = RttMix(target._iSeed + target.dwBuff + static_cast<uint32_t>(attempt));
+        Item candidate {};
+        SetRndSeed(newSeed);
+        SetupAllItems(player, candidate, target.IDidx, newSeed, level, uper, /*onlygood=*/true, pregen, 0, /*forceNotUnique=*/true, false);
+        SetupItem(candidate);
+        if (candidate._iMagical != ITEM_QUALITY_MAGIC) continue;
+        if (recipe == 7 && (candidate._iPrePower != target._iPrePower || candidate._iSufPower != target._iSufPower)) continue;
+        if (candidate._iSeed == target._iSeed) continue; // must actually change something
+        candidate._iIdentified = target._iIdentified;
+        candidate._iDurability = target._iDurability;
+        candidate._iMaxDur = target._iMaxDur;
+        candidate._iCharges = target._iCharges;
+        candidate._iMaxCharges = target._iMaxCharges;
+        candidate.position = target.position;
+        result = candidate;
+        return true;
+    }
+    return false;
+}
+
+// Tier II "Preserve Affix": identical reforge to recipe 2 (Reforge Rare), except the
+// affix code in `selectedSlot` is held fixed instead of being re-rolled with the rest.
+bool RttPreparePreserveAffix(const Player &player, const Item &target, unsigned selectedSlot, Item &result)
+{
+    if (GetRttItemRarity(target) != RttItemRarity::Rare) return false;
+    const int level = target._iCreateInfo & CF_LEVEL;
+    std::array<uint8_t, 4> codes {};
+    for (size_t slot = 0; slot < codes.size(); ++slot) {
+        codes[slot] = GetRttAffixCode(target, slot);
+        if (!IsRttAffixCompatible(target, codes[slot], slot, level)) return false;
+    }
+    const uint8_t preserved = codes[selectedSlot];
+    if (preserved == 0) return false;
+
+    std::array<uint8_t, 4> reforged = BuildRttRareCodes(target, level, target.dwBuff);
+    reforged[selectedSlot] = preserved;
+    if (!IsRttAffixCompatible(target, preserved, selectedSlot, level)) return false;
+
+    Item metadata = target;
+    SetRttMetadata(metadata, RttItemRarity::Rare, reforged);
+    if (metadata.dwBuff == target.dwBuff) return false;
+    Item rebuilt {};
+    RecreateItem(player, rebuilt, target.IDidx, target._iCreateInfo, target._iSeed, target._ivalue, metadata.dwBuff);
+    rebuilt._iIdentified = target._iIdentified;
+    rebuilt._iDurability = target._iDurability;
+    rebuilt._iMaxDur = target._iMaxDur;
+    rebuilt._iCharges = target._iCharges;
+    rebuilt._iMaxCharges = target._iMaxCharges;
+    rebuilt.position = target.position;
+    result = rebuilt;
+    return true;
+}
