+TEST_F(RttPhase4, CraftTierOneAndPreserveAffix)
+{
+    // Tier I recipes (5-7) reuse the exact same SetupAllItems()/RecreateItem() pipeline
+    // as any other item generation - find seeds that produce a Normal and a Magic item
+    // (no RTT metadata) rather than hand-crafting one, so the test exercises the real
+    // generator instead of a shortcut.
+    Item normalItem {}, magicItem {};
+    bool haveNormal = false, haveMagic = false;
+    for (uint32_t seed = 1; seed < 5000 && !(haveNormal && haveMagic); ++seed) {
+        Item a {};
+        SetupAllItems(*MyPlayer, a, Base(ItemType::Sword), seed, 20, 1, false, false);
+        if (HasRttItemMetadata(a)) continue;
+        if (!haveNormal && a._iMagical == ITEM_QUALITY_NORMAL) { normalItem = a; haveNormal = true; }
+        if (!haveMagic && a._iMagical == ITEM_QUALITY_MAGIC) { magicItem = a; haveMagic = true; }
+    }
+    ASSERT_TRUE(haveNormal); ASSERT_TRUE(haveMagic);
+    normalItem._iIdentified = true; magicItem._iIdentified = true;
+
+    Item enchanted {};
+    ASSERT_TRUE(RttPrepareCraft(*MyPlayer, normalItem, 5, 0, enchanted));
+    EXPECT_EQ(enchanted.IDidx, normalItem.IDidx);
+    EXPECT_EQ(enchanted._iMagical, ITEM_QUALITY_MAGIC);
+    RoundTrip(enchanted);
+    EXPECT_FALSE(RttPrepareCraft(*MyPlayer, normalItem, 6, 0, enchanted)); // recipe 6 needs Magic source
+
+    Item reforged {};
+    ASSERT_TRUE(RttPrepareCraft(*MyPlayer, magicItem, 6, 0, reforged));
+    EXPECT_EQ(reforged._iMagical, ITEM_QUALITY_MAGIC);
+    EXPECT_NE(reforged._iSeed, magicItem._iSeed);
+    RoundTrip(reforged);
+
+    Item rerolled {};
+    if (RttPrepareCraft(*MyPlayer, magicItem, 7, 0, rerolled)) {
+        EXPECT_EQ(rerolled._iPrePower, magicItem._iPrePower);
+        EXPECT_EQ(rerolled._iSufPower, magicItem._iSufPower);
+        RoundTrip(rerolled);
+    }
+
+    // Preserve Affix (recipe 8): slot 0's code must survive while the rest reforge.
+    auto rare = Make(ItemType::Sword, 1, { 1, 13, 7, 10 });
+    Item preserved {};
+    ASSERT_TRUE(RttPrepareCraft(*MyPlayer, rare, 8, 0, preserved));
+    EXPECT_EQ(preserved.dwBuff & 0x7E0U, rare.dwBuff & 0x7E0U); // slot 0's 6 code bits unchanged
+    RoundTrip(preserved);
+    EXPECT_FALSE(RttPrepareCraft(*MyPlayer, normalItem, 8, 0, preserved)); // recipe 8 needs a Rare source
+}
