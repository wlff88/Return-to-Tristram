+namespace {
+
+constexpr uint8_t RttWeaponSetVersion = 1;
+constexpr char RttWeaponSetFileName[] = "rtt_weapon_set";
+
+} // namespace
+
+void LoadRttWeaponSet(uint32_t saveNum, Player &player)
+{
+	player.RttAlternateWeaponSet[0].clear();
+	player.RttAlternateWeaponSet[1].clear();
+	player.RttActiveWeaponSet = 0;
+
+	LoadHelper file(OpenSaveArchive(saveNum), RttWeaponSetFileName);
+	if (!file.IsValid())
+		return;
+
+	const uint8_t version = file.NextLE<uint8_t>();
+	if (version != RttWeaponSetVersion)
+		return;
+
+	const bool isHellfireSave = file.NextBool8();
+	const uint8_t activeSet = file.NextLE<uint8_t>();
+	if (activeSet <= 1)
+		player.RttActiveWeaponSet = activeSet;
+
+	for (Item &item : player.RttAlternateWeaponSet) {
+		if (!file.IsValid(sizeof(ItemPack))) {
+			player.RttAlternateWeaponSet[0].clear();
+			player.RttAlternateWeaponSet[1].clear();
+			player.RttActiveWeaponSet = 0;
+			return;
+		}
+		ItemPack packedItem {};
+		file.NextBytes(&packedItem, sizeof(packedItem));
+		UnPackItem(packedItem, player, item, isHellfireSave);
+		RemoveInvalidItem(item);
+	}
+}
+
+void SaveRttWeaponSet(SaveWriter &saveWriter, const Player &player)
+{
+	constexpr size_t FileSize = 3 * sizeof(uint8_t) + 2 * sizeof(ItemPack);
+	SaveHelper file(saveWriter, RttWeaponSetFileName, FileSize);
+
+	file.WriteLE<uint8_t>(RttWeaponSetVersion);
+	file.WriteLE<uint8_t>(gbIsHellfire ? 1 : 0);
+	file.WriteLE<uint8_t>(player.RttActiveWeaponSet <= 1 ? player.RttActiveWeaponSet : 0);
+
+	for (const Item &item : player.RttAlternateWeaponSet) {
+		ItemPack packedItem {};
+		PackItem(packedItem, item, gbIsHellfire);
+		file.WriteBytes(&packedItem, sizeof(packedItem));
+	}
+}
