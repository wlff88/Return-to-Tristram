+bool SwapWeaponSet(Player &player)
+{
+	if (!player.HoldItem.isEmpty()) {
+		if (&player == MyPlayer)
+			EventPlrMsg(_("Cannot swap weapon sets while holding an item."), UiFlags::ColorRed);
+		return false;
+	}
+
+	std::swap(player.InvBody[INVLOC_HAND_LEFT], player.RttAlternateWeaponSet[0]);
+	std::swap(player.InvBody[INVLOC_HAND_RIGHT], player.RttAlternateWeaponSet[1]);
+	player.RttActiveWeaponSet ^= 1;
+
+	CalcPlrInv(player, true);
+
+	if (&player == MyPlayer) {
+		NetSendCmdChItem(false, INVLOC_HAND_LEFT, true);
+		NetSendCmdChItem(false, INVLOC_HAND_RIGHT, true);
+		EventPlrMsg(FormatRuntime(_("Weapon set {:d}"), player.RttActiveWeaponSet + 1), UiFlags::ColorWhite);
+	}
+
+	return true;
+}
