+void EnsureRttNecromancerProgression(Player &player)
+{
+	if (GetActiveModSaveExtension() != "rtt" || player._pClass != HeroClass::Sorcerer)
+		return;
+
+	const auto unlock = [&player](SpellID spell, uint8_t minimumLevel) {
+		if (player.getCharacterLevel() < minimumLevel)
+			return;
+		const auto index = static_cast<size_t>(spell);
+		player._pMemSpells |= GetSpellBitmask(spell);
+		player._pSplLvl[index] = std::max<uint8_t>(player._pSplLvl[index], 1);
+	};
+
+	unlock(SpellID::HolyBolt, 1);   // Bone Spike
+	unlock(SpellID::ManaShield, 4); // Bone Armor
+	unlock(SpellID::BloodStar, 8);  // Grave Pact
+
+	// Ossuary Mastery: the vertical slice grants a stable extra rank to the
+	// primary bone skill and armor once level 15 is reached.
+	if (player.getCharacterLevel() >= 15) {
+		player._pSplLvl[static_cast<size_t>(SpellID::HolyBolt)] = std::max<uint8_t>(player._pSplLvl[static_cast<size_t>(SpellID::HolyBolt)], 2);
+		player._pSplLvl[static_cast<size_t>(SpellID::ManaShield)] = std::max<uint8_t>(player._pSplLvl[static_cast<size_t>(SpellID::ManaShield)], 2);
+	}
+}
