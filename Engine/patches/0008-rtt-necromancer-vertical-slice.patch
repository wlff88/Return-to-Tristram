+		if ((pmask & (1 << MyPlayerId)) != 0) {
 			MyPlayer->addExperience(e, lvl);
+			EnsureRttNecromancerProgression(*MyPlayer);
+			// Soul Siphon notable: from level 6 onward, kills restore 2% of
+			// maximum mana. This runs only for the local player credited by pmask.
+			if (GetActiveModSaveExtension() == "rtt" && MyPlayer->_pClass == HeroClass::Sorcerer && MyPlayer->getCharacterLevel() >= 6) {
+				const int restore = std::max(MyPlayer->_pMaxMana / 50, 1);
+				const int actual = std::min(restore, MyPlayer->_pMaxMana - MyPlayer->_pMana);
+				MyPlayer->_pMana += actual;
+				MyPlayer->_pManaBase = std::min(MyPlayer->_pManaBase + actual, MyPlayer->_pMaxManaBase);
+				if (actual > 0)
+					RedrawComponent(PanelDrawComponent::Mana);
+			}
+		}
 	}
 }
