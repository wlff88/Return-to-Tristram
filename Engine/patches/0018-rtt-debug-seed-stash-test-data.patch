+// RTT: not real crafting materials (those don't exist yet, see Phase 2 of the
+// Item UX/Salvage/Crafting rework) - just reused generic items + gold dropped
+// straight into the stash, so the new physical stash chest has visible content
+// to manually test against instead of an empty stash.
+std::string RttDebugSeedStashTestData()
+{
+	constexpr int seedGold = 5000;
+	Stash.gold += seedGold;
+
+	struct Placeholder {
+		_item_indexes idx;
+		Point cell;
+	};
+	constexpr Placeholder placeholders[] = {
+		{ IDI_HEAL, { 0, 0 } },
+		{ IDI_MANA, { 1, 0 } },
+		{ IDI_PORTAL, { 2, 0 } },
+	};
+
+	int created = 0;
+	for (const auto &placeholder : placeholders) {
+		if (Stash.IsItemAtPosition(placeholder.cell))
+			continue;
+
+		Item item;
+		SetupAllItems(*MyPlayer, item, placeholder.idx, AdvanceRndSeed(), 1, 1, false, false);
+		SetupItem(item);
+		item._iIdentified = true;
+
+		Stash.stashList.emplace_back(item.pop());
+		const auto stashListIndex = static_cast<uint16_t>(Stash.stashList.size() - 1);
+		Stash.GetCurrentGrid()[placeholder.cell.x][placeholder.cell.y] = stashListIndex + 1;
+		created++;
+	}
+
+	Stash.dirty = true;
+	Stash.RefreshItemStatFlags();
+
+	return StrCat("Seeded stash with ", seedGold, " gold and ", created,
+	    " placeholder items (test-only stand-ins, not real crafting materials).");
+}
+
 } // namespace
 
