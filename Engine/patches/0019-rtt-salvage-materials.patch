 } // namespace
 
+bool RttSalvageModeActive = false;
+
+enum class RttSalvageTier : uint8_t {
+	Normal,
+	Magic,
+	Rare,
+	UniqueOrSet,
+};
+
+RttSalvageTier RttGetSalvageTier(const Item &item)
+{
+	if (item._iMagical == ITEM_QUALITY_UNIQUE)
+		return RttSalvageTier::UniqueOrSet;
+	if (HasRttItemMetadata(item)) {
+		switch (GetRttItemRarity(item)) {
+		case RttItemRarity::Set:
+		case RttItemRarity::Unique:
+			return RttSalvageTier::UniqueOrSet;
+		case RttItemRarity::Rare:
+			return RttSalvageTier::Rare;
+		default:
+			break;
+		}
+	}
+	if (item._iMagical == ITEM_QUALITY_MAGIC)
+		return RttSalvageTier::Magic;
+	return RttSalvageTier::Normal;
+}
+
+namespace {
+
+void RttGrantMaterial(Player &player, _item_indexes idx, int count, std::string &grantedSummary)
+{
+	int granted = 0;
+	for (int i = 0; i < count; i++) {
+		Item material;
+		InitializeItem(material, idx);
+		material._iIdentified = true;
+		if (!AutoPlaceItemInInventory(player, material, true))
+			break;
+		granted++;
+	}
+	if (granted > 0) {
+		if (!grantedSummary.empty())
+			grantedSummary += ", ";
+		StrAppend(grantedSummary, "+", granted, " ", AllItemsList[static_cast<size_t>(idx)].iName);
+	}
+}
+
+} // namespace
+
+// RTT Salvage: destroys an identified or unidentified piece of equipment at the
+// Anvil (Griswold) in exchange for crafting materials, tiered by rarity per the
+// Item UX/Salvage/Crafting design (Normal->Iron Scrap, Magic->+Arcane Dust,
+// Rare->Arcane Dust+Blood Shard, Unique/Set->a rare material). Placeholder
+// quantities - balance to be tuned later, same as the Horadric Knowledge costs.
+void RttSalvageItem(Player &player, Item &item)
+{
+	if (&player != MyPlayer || item.isEmpty() || !item.isEquipment())
+		return;
+
+	std::string grantedSummary;
+	switch (RttGetSalvageTier(item)) {
+	case RttSalvageTier::Normal:
+		RttGrantMaterial(player, IDI_RTT_IRONSCRAP, 2, grantedSummary);
+		break;
+	case RttSalvageTier::Magic:
+		RttGrantMaterial(player, IDI_RTT_IRONSCRAP, 1, grantedSummary);
+		RttGrantMaterial(player, IDI_RTT_ARCANEDUST, 1, grantedSummary);
+		break;
+	case RttSalvageTier::Rare:
+		RttGrantMaterial(player, IDI_RTT_ARCANEDUST, 1, grantedSummary);
+		RttGrantMaterial(player, IDI_RTT_BLOODSHARD, 2, grantedSummary);
+		break;
+	case RttSalvageTier::UniqueOrSet:
+		RttGrantMaterial(player, IDI_RTT_RARESHARD, 1, grantedSummary);
+		break;
+	}
+
+	const std::string itemName = std::string(item.getName());
+	item.clear();
+	CalcPlrInv(player, true);
+
+	if (grantedSummary.empty())
+		EventPlrMsg(FormatRuntime(_("Salvaged {:s}, but your inventory is full - no materials fit."), itemName), UiFlags::ColorRed);
+	else
+		EventPlrMsg(FormatRuntime(_("Salvaged {:s}: {:s}."), itemName, grantedSummary), UiFlags::ColorWhitegold);
+}
