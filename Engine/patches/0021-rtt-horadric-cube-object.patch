+void RttOperateHoradricCube(Player &player)
+{
+	if (&player != MyPlayer)
+		return;
+
+	if (player.HoldItem.isEmpty()) {
+		EventPlrMsg(_("Bring an item to the Horadric Cube to work it."), UiFlags::ColorWhite);
+		return;
+	}
+
+	if (player.RttHoradricKnowledgeTier < 2) {
+		EventPlrMsg(_("You lack the Horadric Knowledge to use the Cube. Learn it from Cain."), UiFlags::ColorRed);
+		return;
+	}
+
+	if (!RttIsRareTierItem(player.HoldItem)) {
+		EventPlrMsg(_("Only Rare items can be worked at the Horadric Cube."), UiFlags::ColorRed);
+		return;
+	}
+
+	StartStore(TalkID::RttHoradricCube);
