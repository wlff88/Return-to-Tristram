+// RTT: the existing RttPrepareCraft/RttCraftHeldRare mutation engine (patch 0010) only
+// supports Rare-tier items; the Horadric Cube (patch 0021) uses this to report
+// eligibility to the player before offering any recipe.
+bool RttIsRareTierItem(const Item &item)
+{
+	return HasRttItemMetadata(item) && GetRttItemRarity(item) == RttItemRarity::Rare;
+}
