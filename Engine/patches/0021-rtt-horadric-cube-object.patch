+struct RttHoradricRecipe {
+	const char *name;
+	int cost;
+	int requiredTier;
+	bool (*run)(Player &);
+};
+
+// Costs match the existing RttCraftHeldRare recipe-cost table exactly (recipes 2/3/4).
+// Only the 3 recipes Horadric Knowledge II/III actually unlock have a working engine
+// implementation (patch 0010); the other ~10 named recipes from the Item UX/Salvage/
+// Crafting spec (Enchant Normal Item, Preserve Affix, Awaken Unique, etc.) have none yet.
+constexpr std::array<RttHoradricRecipe, 3> RttHoradricRecipes { {
+	{ N_("Reforge Rare"), 100, 2, RttReforgeHeldRare },
+	{ N_("Reroll Affix Slot"), 50, 2, RttRerollHeldAffixSlot },
+	{ N_("Raise Affix Tier"), 150, 3, RttRaiseHeldAffixTier },
+} };
+
+void RttStartHoradricCube()
+{
+	IsTextFullSize = false;
+	HasScrollbar = false;
+	AddSText(0, 1, _("Horadric Cube"), UiFlags::ColorWhitegold | UiFlags::AlignCenter, false);
+	AddSText(0, 3, _("Bring a Rare item, then choose:"), UiFlags::ColorWhitegold | UiFlags::AlignCenter, false);
+	AddSLine(5);
+
+	const Player &myPlayer = *MyPlayer;
+	int line = 7;
+	for (const RttHoradricRecipe &recipe : RttHoradricRecipes) {
+		if (myPlayer.RttHoradricKnowledgeTier >= recipe.requiredTier) {
+			AddSText(0, line, FormatRuntime(_("{:s} ({:d} Gold)"), _(recipe.name), recipe.cost), UiFlags::ColorWhite | UiFlags::AlignCenter, true);
+		} else {
+			AddSText(0, line, FormatRuntime(_("Unknown Recipe (Requires Horadric Knowledge {:s})"), RttHoradricKnowledgeTierNames[recipe.requiredTier - 1]), UiFlags::ColorRed | UiFlags::AlignCenter, false);
+		}
+		line += 2;
+	}
+
+	AddSLine(line);
+	AddSText(0, line + 2, _("Leave"), UiFlags::ColorWhite | UiFlags::AlignCenter, true);
+}
+
+void RttHoradricCubeEnter()
+{
+	Player &myPlayer = *MyPlayer;
+
+	int line = 7;
+	for (const RttHoradricRecipe &recipe : RttHoradricRecipes) {
+		if (CurrentTextLine == line) {
+			if (myPlayer.RttHoradricKnowledgeTier >= recipe.requiredTier) {
+				if (recipe.run(myPlayer))
+					EventPlrMsg(FormatRuntime(_("The Horadric Cube reworks the item: {:s}."), _(recipe.name)), UiFlags::ColorWhitegold);
+				else
+					EventPlrMsg(_("The Horadric Cube rejects this item."), UiFlags::ColorRed);
+			}
+			ActiveStore = TalkID::None;
+			return;
+		}
+		line += 2;
+	}
+
+	ActiveStore = TalkID::None;
+}
+
