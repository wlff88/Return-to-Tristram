+void RttOperateHoradricCube(Player &player)
+{
+	if (&player != MyPlayer)
+		return;
+
+	if (player.HoldItem.isEmpty()) {
+		EventPlrMsg(_("Bring an item to the Horadric Cube to work it."), UiFlags::ColorWhite);
+		return;
+	}
+
+	if (player.RttHoradricKnowledgeTier < 2) {
+		EventPlrMsg(_("You lack the Horadric Knowledge to use the Cube. Learn it from Cain."), UiFlags::ColorRed);
+		return;
+	}
+
+	if (!RttIsRareTierItem(player.HoldItem)) {
+		EventPlrMsg(_("Only Rare items can be worked at the Horadric Cube."), UiFlags::ColorRed);
+		return;
+	}
+
+	// RttReforgeHeldRare()/RttRaiseHeldAffixTier()/RttRerollHeldAffixSlot() already implement
+	// and validate (Rare tier, affordability) the 3 recipes Horadric Knowledge II/III unlock -
+	// only the recipe-selection UI itself (Phase 4 of the Item UX/Salvage/Crafting rework)
+	// remains to be built, so nothing is executed yet.
+	EventPlrMsg(_("The Horadric Cube recognizes this item, but its recipe menu isn't built yet."), UiFlags::ColorWhitegold);
 }
 
