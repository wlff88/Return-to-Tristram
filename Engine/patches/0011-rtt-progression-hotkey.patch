+bool RttSpendNextProgressionPoint(Player &player)
+{
+    // There is currently only one implemented choice per slot (rtt::Choose()
+    // only accepts choice == 1), so "pick a slot" reduces to "spend on the
+    // lowest-numbered slot that is unlocked, unspent, and affordable" -- there
+    // is no meaningful alternative to present in a menu yet.
+    if (&player != MyPlayer)
+        return false;
+    static const std::array<const char *, 4> SlotNames { N_("Bone Spike"), N_("Bone Armor"), N_("Grave Pact"), N_("Ossuary Mastery") };
+    for (unsigned slot = 0; slot < SlotNames.size(); ++slot) {
+        if (RttChooseProgression(player, slot, 1, true)) {
+            EventPlrMsg(FormatRuntime(_("RTT: {:s} upgraded."), _(SlotNames[slot])), UiFlags::ColorWhite);
+            return true;
+        }
+    }
+    return false;
+}
