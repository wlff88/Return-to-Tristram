diff --git a/test/rtt_phase4_test.cpp b/test/rtt_phase4_test.cpp
--- a/test/rtt_phase4_test.cpp
+++ b/test/rtt_phase4_test.cpp
@@ -253,5 +253,22 @@ TEST_F(RttPhase4, JewelryNeverGetsArmorClassAffix)
     }
     EXPECT_TRUE(sawRare);
 }
+TEST_F(RttPhase4, SpendNextProgressionPointHotkey)
+{
+    // Earned(1)==0 (see rtt_progression.h), so nothing is spendable at level 1;
+    // advance to level 2 first, matching NecromancerCreateUnlockSaveChoices.
+    MyPlayer->setCharacterLevel(2); EnsureRttNecromancerProgression(*MyPlayer);
+    ASSERT_TRUE(RttSpendNextProgressionPoint(*MyPlayer));
+    EXPECT_EQ(MyPlayer->rttProgression[5], 1); // Bone Spike (slot 0) chosen first.
+    EXPECT_FALSE(RttSpendNextProgressionPoint(*MyPlayer)); // No points left until the next gate.
+
+    MyPlayer->setCharacterLevel(4); EnsureRttNecromancerProgression(*MyPlayer);
+    ASSERT_TRUE(RttSpendNextProgressionPoint(*MyPlayer));
+    EXPECT_EQ(MyPlayer->rttProgression[6], 1); // Bone Armor (slot 1) chosen next, not re-picking slot 0.
+
+    // Never spends on someone else's behalf, matching RttChooseProgression's own guard.
+    Players[1]._pClass = HeroClass::Sorcerer; Players[1].setCharacterLevel(4);
+    EXPECT_FALSE(RttSpendNextProgressionPoint(Players[1]));
+}
