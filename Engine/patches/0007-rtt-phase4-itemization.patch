+bool RebuildHeldRttRare(Player &player, uint32_t metadata)
+{
+	Item &held = player.HoldItem;
+	if (held.isEmpty() || GetRttItemRarity(held) != RttItemRarity::Rare)
+		return false;
+
+	const bool identified = held._iIdentified;
+	const uint32_t upstreamBuff = held.dwBuff & RttUpstreamBuffMask;
+	Item rebuilt {};
+	RecreateItem(player, rebuilt, held.IDidx, held._iCreateInfo, held._iSeed, held._ivalue, upstreamBuff);
+	rebuilt.dwBuff = upstreamBuff | metadata;
+	ApplyRttItemMetadata(rebuilt);
+	rebuilt._iIdentified = identified;
+	held = rebuilt;
+	CalcPlrInv(player, true);
+	return true;
+}
+
+} // namespace
+
+bool RttReforgeHeldRare(Player &player)
+{
+	if (!IsRttRuntime() || player.HoldItem.isEmpty() || GetRttItemRarity(player.HoldItem) != RttItemRarity::Rare)
+		return false;
+	Item prototype = player.HoldItem;
+	const int level = prototype._iCreateInfo & CF_LEVEL;
+	SetRttMetadata(prototype, RttItemRarity::Rare, BuildRttRareCodes(prototype, level, prototype.dwBuff));
+	const bool ok = RebuildHeldRttRare(player, prototype.dwBuff & ~RttUpstreamBuffMask);
+	if (ok)
+		EventPlrMsg(_("RTT: rare item reforged."), UiFlags::ColorWhite);
+	return ok;
+}
+
+bool RttRaiseHeldAffixTier(Player &player)
+{
+	if (!IsRttRuntime() || player.HoldItem.isEmpty() || GetRttItemRarity(player.HoldItem) != RttItemRarity::Rare)
+		return false;
+	Item prototype = player.HoldItem;
+	const int level = prototype._iCreateInfo & CF_LEVEL;
+	std::array<uint8_t, 4> codes {};
+	bool changed = false;
+	for (size_t slot = 0; slot < codes.size(); ++slot) {
+		codes[slot] = GetRttAffixCode(prototype, slot);
+		if (!changed && codes[slot] != 0 && ((codes[slot] - 1) % 3) != 2) {
+			const uint8_t next = codes[slot] + 1;
+			const int requiredLevel = ((next - 1) % 3) == 1 ? 10 : 20;
+			if (level >= requiredLevel) {
+				codes[slot] = next;
+				changed = true;
+			}
+		}
+	}
+	if (!changed)
+		return false;
+	SetRttMetadata(prototype, RttItemRarity::Rare, codes);
+	const bool ok = RebuildHeldRttRare(player, prototype.dwBuff & ~RttUpstreamBuffMask);
+	if (ok)
+		EventPlrMsg(_("RTT: affix tier raised."), UiFlags::ColorWhite);
+	return ok;
+}
+
+bool RttRerollHeldAffixSlot(Player &player)
+{
+	if (!IsRttRuntime() || player.HoldItem.isEmpty() || GetRttItemRarity(player.HoldItem) != RttItemRarity::Rare)
+		return false;
+	Item prototype = player.HoldItem;
+	const int level = prototype._iCreateInfo & CF_LEVEL;
+	auto codes = BuildRttRareCodes(prototype, level, prototype.dwBuff ^ 0x534C4F54U);
+	SetRttMetadata(prototype, RttItemRarity::Rare, codes);
+	const bool ok = RebuildHeldRttRare(player, prototype.dwBuff & ~RttUpstreamBuffMask);
+	if (ok)
+		EventPlrMsg(_("RTT: affix slot rerolled."), UiFlags::ColorWhite);
+	return ok;
+}
 
