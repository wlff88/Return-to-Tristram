diff --git a/Source/panels/waypoint_panel.cpp b/Source/panels/waypoint_panel.cpp
new file mode 100644
--- /dev/null
+++ b/Source/panels/waypoint_panel.cpp
@@ -0,0 +1,164 @@
+#include "panels/waypoint_panel.hpp"
+
+#include <algorithm>
+#include <array>
+#include <string>
+#include <string_view>
+
+#include "DiabloUI/ui_flags.hpp"
+#include "control/control.hpp"
+#include "effects.h"
+#include "engine/render/clx_render.hpp"
+#include "engine/render/text_render.hpp"
+#include "minitext.h"
+#include "panels/quest_log.hpp"
+#include "panels/ui_panels.hpp"
+#include "player.h"
+#include "utils/format.hpp"
+#include "utils/language.h"
+
+namespace devilution {
+
+bool WaypointPanelIsOpen;
+
+namespace {
+
+/** Dungeon levels (1-16) the local player has visited, in ascending order */
+std::array<int, 16> EncounteredLevels;
+/** Number of valid entries in EncounteredLevels */
+int EncounteredLevelCount;
+/** Currently selected entry, or -1 if there is nothing to select */
+int SelectedWaypoint;
+
+constexpr Rectangle InnerPanel { { 32, 26 }, { 280, 300 } };
+constexpr int LineHeight = 12;
+int ListYOffset;
+int LineSpacing;
+
+std::string_view DungeonBranchName(int level)
+{
+    if (level <= 4) return _("Cathedral");
+    if (level <= 8) return _("Catacombs");
+    if (level <= 12) return _("Caves");
+    return _("Hell");
+}
+
+int WaypointMouseToEntry()
+{
+    Rectangle innerArea = InnerPanel;
+    innerArea.position += Displacement(GetLeftPanel().position.x, GetLeftPanel().position.y);
+    if (!innerArea.contains(MousePosition) || EncounteredLevelCount == 0)
+        return -1;
+    const int y = MousePosition.y - innerArea.position.y;
+    for (int i = 0; i < EncounteredLevelCount; i++) {
+        if (y >= ListYOffset + i * LineSpacing && y < ListYOffset + i * LineSpacing + LineHeight) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void PrintWaypointString(const Surface &out, int x, int y, std::string_view str, bool marked)
+{
+    const int width = GetLineWidth(str);
+    x += std::max((257 - width) / 2, 0);
+    if (marked) {
+        ClxDraw(out, GetPanelPosition(UiPanels::Quest, { x - 20, y + 13 }), (*pSPentSpn2Cels)[PentSpn2Spin()]);
+    }
+    DrawString(out, str, { GetPanelPosition(UiPanels::Quest, { x, y }), { 257, 0 } },
+        { .flags = UiFlags::ColorWhite });
+    if (marked) {
+        ClxDraw(out, GetPanelPosition(UiPanels::Quest, { x + width + 7, y + 13 }), (*pSPentSpn2Cels)[PentSpn2Spin()]);
+    }
+}
+
+} // namespace
+
+void DrawWaypointPanel(const Surface &out)
+{
+    const int l = WaypointMouseToEntry();
+    if (l >= 0) {
+        SelectedWaypoint = l;
+    }
+    const auto x = InnerPanel.position.x;
+    // Reuses the quest log's own background frame: RTT ships no new art
+    // assets, and a waypoint list is visually the same shape of panel.
+    ClxDraw(out, GetPanelPosition(UiPanels::Quest, { 0, 351 }), (*pQLogCel)[0]);
+    int y = InnerPanel.position.y + ListYOffset;
+    for (int i = 0; i < EncounteredLevelCount; i++) {
+        const int level = EncounteredLevels[i];
+        const std::string label = FormatRuntime(_("{:s} {:d}"), DungeonBranchName(level), level);
+        PrintWaypointString(out, x, y, label, i == SelectedWaypoint);
+        y += LineSpacing;
+    }
+}
+
+void StartWaypointPanel()
+{
+    EncounteredLevelCount = 0;
+    if (MyPlayer != nullptr) {
+        for (int level = 1; level <= 16; level++) {
+            if (MyPlayer->_pLvlVisited[level])
+                EncounteredLevels[EncounteredLevelCount++] = level;
+        }
+    }
+
+    ListYOffset = 0;
+    LineSpacing = LineHeight;
+    const int space = InnerPanel.size.height;
+    if (EncounteredLevelCount > 0) {
+        const int additionalSpace = space - EncounteredLevelCount * LineHeight;
+        const int addLineSpacing = std::clamp(additionalSpace / EncounteredLevelCount, 0, LineHeight);
+        LineSpacing = LineHeight + addLineSpacing;
+        const int overallHeight = EncounteredLevelCount * LineSpacing;
+        ListYOffset = std::max(0, (space - overallHeight) / 2);
+    }
+
+    SelectedWaypoint = EncounteredLevelCount > 0 ? 0 : -1;
+    WaypointPanelIsOpen = true;
+}
+
+void WaypointPanelUp()
+{
+    if (EncounteredLevelCount == 0) {
+        SelectedWaypoint = -1;
+        return;
+    }
+    SelectedWaypoint--;
+    if (SelectedWaypoint < 0) {
+        SelectedWaypoint = EncounteredLevelCount - 1;
+    }
+    PlaySFX(SfxID::MenuMove);
+}
+
+void WaypointPanelDown()
+{
+    if (EncounteredLevelCount == 0) {
+        SelectedWaypoint = -1;
+        return;
+    }
+    SelectedWaypoint++;
+    if (SelectedWaypoint >= EncounteredLevelCount) {
+        SelectedWaypoint = 0;
+    }
+    PlaySFX(SfxID::MenuMove);
+}
+
+void WaypointPanelEnter()
+{
+    PlaySFX(SfxID::MenuSelect);
+    if (EncounteredLevelCount != 0 && SelectedWaypoint >= 0 && SelectedWaypoint < EncounteredLevelCount) {
+        RttWarpToLevel(*MyPlayer, static_cast<uint8_t>(EncounteredLevels[SelectedWaypoint]));
+    }
+    WaypointPanelIsOpen = false;
+}
+
