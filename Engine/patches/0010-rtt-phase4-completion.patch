+TEST_F(RttPhase4, NormalXpMultiplierOnly)
+{
+    for(auto difficulty : {DIFF_NORMAL,DIFF_NIGHTMARE,DIFF_HELL}) {
+        sgGameInitInfo.nDifficulty = difficulty;
+        MyPlayer->_pExperience = 0;
+        MyPlayer->addExperience(100);
