diff --git a/Source/rtt_progression.h b/Source/rtt_progression.h
new file mode 100644
--- /dev/null
+++ b/Source/rtt_progression.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cstdint>
+
+namespace devilution::rtt {
+// Save Schema v2 binary projection. These offsets are append-only.
+// [0] marker, [1] version, [2] logical class, [3] highest awarded level,
+// [4] unspent points, [5..7] active upgrades, [8] specialization,
+// [9] unlock mask (active, active, notable, active, mastery).
+using Progression = std::array<uint8_t, 20>;
+constexpr std::array<uint8_t, 7> PointLevels { 2, 4, 6, 8, 10, 12, 15 };
+inline unsigned Earned(unsigned level)
+{
+    return static_cast<unsigned>(std::count_if(PointLevels.begin(), PointLevels.end(), [level](unsigned gate) { return level >= gate; }));
+}
+inline uint8_t Unlocks(unsigned level)
+{
+    uint8_t mask = 0;
+    unsigned bit = 0;
+    for (unsigned gate : { 1, 4, 6, 8, 15 }) {
+        if (level >= gate) mask |= 1U << bit;
+        ++bit;
+    }
+    return mask;
+}
+inline bool Valid(const Progression &s, unsigned level)
+{
+    if (s[0] != 0x52 || s[1] != 2 || s[2] != 2 || s[3] < 1 || s[3] > level || s[9] != Unlocks(s[3])) return false;
+    unsigned spent = 0;
+    for (unsigned i = 5; i <= 8; ++i) {
+        if (s[i] > 1) return false; // Only implemented choices may be selected.
+        spent += s[i];
+    }
+    if ((s[6] && s[3] < 4) || (s[7] && s[3] < 8) || (s[8] && s[3] < 15)) return false;
+    for (unsigned i = 10; i < s.size(); ++i) if (s[i] != 0) return false;
+    return s[4] + spent == Earned(s[3]);
+}
+inline void Advance(Progression &s, uint8_t level)
+{
+    if (s[0] == 0) s = { 0x52, 2, 2, 1, 0, 0, 0, 0, 0, 1 };
+    if (!Valid(s, std::max<unsigned>(level, s[3])) || level <= s[3]) return;
+    s[4] += static_cast<uint8_t>(Earned(level) - Earned(s[3]));
+    s[3] = level;
+    s[9] = Unlocks(level);
+}
+inline bool Choose(Progression &s, unsigned level, unsigned slot, unsigned choice)
+{
+    if (!Valid(s, level) || slot > 3 || choice != 1 || s[4] == 0 || s[5 + slot] != 0) return false;
+    constexpr std::array<unsigned, 4> Gates { 1, 4, 8, 15 };
+    if (s[3] < Gates[slot]) return false;
+    s[5 + slot] = 1;
+    --s[4];
+    return true;
+}
+} // namespace devilution::rtt
