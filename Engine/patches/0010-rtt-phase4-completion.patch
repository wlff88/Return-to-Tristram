+TEST_F(RttPhase4, NecromancerCreateUnlockSaveChoices)
+{
+    ASSERT_EQ(MyPlayer->rttProgression[2],2);
+    for(unsigned level:{1,4,6,8,15}) {
+        MyPlayer->setCharacterLevel(level); EnsureRttNecromancerProgression(*MyPlayer);
+        EXPECT_EQ(MyPlayer->rttProgression[9],rtt::Unlocks(level));
