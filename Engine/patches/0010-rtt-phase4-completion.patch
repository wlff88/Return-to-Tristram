+    MyPlayer->InvBody[INVLOC_CHEST].clear(); CalcPlrItemVals(*MyPlayer,false); EXPECT_EQ(MyPlayer->rttBoneArmorRank,0);
+}
+TEST_F(RttPhase4, CraftRecipesAndFailureAtomicity)
+{
+    auto a=Make(ItemType::Sword,1,{1,13,7,10}); a._iDurability=7;
+    for(unsigned recipe=2;recipe<=4;++recipe) {
+        Item result {}; ASSERT_TRUE(RttPrepareCraft(*MyPlayer,a,recipe,0,result));
