+class RttPhase4 : public ::testing::Test {
+protected:
+    void SetUp() override
+    {
+        LoadItemData(); LoadSpellData(); LoadPlayerDataFiles(); LoadMonsterData();
+        Players.resize(2); MyPlayer = &Players[0]; MyPlayerId = 0;
+        gbIsSpawn = false; gbIsHellfire = false; gbIsMultiplayer = false;
+        ModIdentifier mod {}; mod.name = "rtt"; mod.manifest.saveExtension = "rtt";
+        ActiveModIdentifiers = { mod };
+        CreatePlayer(*MyPlayer, HeroClass::Sorcerer);
+        MyPlayer->_pBaseStr = MyPlayer->_pBaseMag = MyPlayer->_pBaseDex = 100;
+    }
+    void TearDown() override { ActiveModIdentifiers.clear(); }
+    _item_indexes Base(ItemType type)
+    {
+        for (size_t i = 0; i < AllItemsList.size(); ++i)
+            if (AllItemsList[i].itype == type && AllItemsList[i].dropRate > 0) return static_cast<_item_indexes>(i);
+        ADD_FAILURE() << "Missing base type"; return IDI_SHORTSTAFF;
+    }
+    Item Make(ItemType type, uint32_t rarity, std::array<unsigned,4> codes, unsigned level = 20)
+    {
+        uint32_t metadata = 0x80000000U | (rarity << 29);
+        for (unsigned i = 0; i < 4; ++i) metadata |= codes[i] << (5 + 6*i);
+        Item item {}; RecreateItem(*MyPlayer, item, Base(type), level | CF_UPER1, 12345, 0, metadata);
+        item._iIdentified = true; item._iStatFlag = true; return item;
+    }
+    void Same(const Item &a, const Item &b)
+    {
+        EXPECT_EQ(a.dwBuff,b.dwBuff); EXPECT_EQ(a.IDidx,b.IDidx); EXPECT_EQ(a._iSeed,b._iSeed);
+        EXPECT_EQ(a._iCreateInfo,b._iCreateInfo); EXPECT_STREQ(a._iIName,b._iIName);
+        EXPECT_EQ(a._iPLDam,b._iPLDam); EXPECT_EQ(a._iPLAC,b._iPLAC);
+        EXPECT_EQ(a._iPLFR,b._iPLFR); EXPECT_EQ(a._iPLLR,b._iPLLR); EXPECT_EQ(a._iPLVit,b._iPLVit);
+    }
+    void RoundTrip(const Item &a)
+    {
+        ItemPack save {}; PackItem(save,a,false); Item b {}; UnPackItem(save,*MyPlayer,b,false); Same(a,b);
+        ItemNetPack net {}; PackNetItem(a,net);
+        Item c {},d {}; ASSERT_TRUE(UnPackNetItem(*MyPlayer,net,c)); ASSERT_TRUE(UnPackNetItem(Players[1],net,d));
+        Same(a,c); Same(c,d);
+    }
+};
+TEST_F(RttPhase4, LegacyNoMarker)
+{
+    Item a {}; RecreateItem(*MyPlayer,a,Base(ItemType::Sword),20 | CF_UPER1,12345,0,0);
+    EXPECT_EQ(a.dwBuff & 0x80000000U,0U); RoundTrip(a);
+}
+TEST_F(RttPhase4, RareEveryCountAndTier)
+{
+    for (unsigned tier=0;tier<3;++tier) for (unsigned count=1;count<=4;++count) {
+        std::array<unsigned,4> codes {1+tier,13+tier,7+tier,10+tier};
+        for (unsigned i=count;i<4;++i) codes[i]=0;
+        RoundTrip(Make(ItemType::Sword,1,codes));
+    }
+}
+TEST_F(RttPhase4, FreshDropsNamedAndRareCounts)
+{
+    std::set<unsigned> counts; std::set<std::string> names;
+    for (auto type : {ItemType::Staff,ItemType::Shield,ItemType::LightArmor}) {
+        for (uint32_t seed=1;seed<3000;++seed) {
+            Item a {}; SetupAllItems(*MyPlayer,a,Base(type),seed,20,1,false,false);
+            const unsigned rarity=(a.dwBuff >> 29)&3;
+            if ((a.dwBuff & 0x80000000U)==0) continue;
+            if (rarity>=2) names.insert(a._iIName);
+            else { unsigned count=0; for(unsigned i=0;i<4;++i) count+=((a.dwBuff>>(5+6*i))&63)!=0; counts.insert(count); }
+        }
+    }
+    EXPECT_EQ(counts,(std::set<unsigned>{1,2,3,4}));
+    for(auto name:{"Ashen Covenant","Boneward","Gravewhisper","Ossuary Guard","Ossuary Vestment"}) EXPECT_TRUE(names.contains(name));
+}
+TEST_F(RttPhase4, UniqueRoundTrip)
+{
+    RoundTrip(Make(ItemType::Staff,3,{2,60,8,0},12));
