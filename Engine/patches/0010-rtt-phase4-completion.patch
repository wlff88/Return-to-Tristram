+bool RttPrepareCraft(const Player &player, const Item &target, unsigned recipe, unsigned selectedSlot, Item &result)
+{
+    if (!IsRttRuntime() || target.isEmpty() || !target.isEquipment() || !target._iIdentified || GetRttItemRarity(target) != RttItemRarity::Rare || recipe < 2 || recipe > 4 || selectedSlot >= 4) return false;
+    const int level = target._iCreateInfo & CF_LEVEL;
+    std::array<uint8_t, 4> codes {};
+    for (size_t slot = 0; slot < codes.size(); ++slot) {
+        codes[slot] = GetRttAffixCode(target, slot);
+        if (!IsRttAffixCompatible(target, codes[slot], slot, level)) return false;
+    }
+    if (recipe == 2) {
+        codes = BuildRttRareCodes(target, level, target.dwBuff);
+    } else {
+        const auto code = codes[selectedSlot];
+        if (code == 0) return false;
+        if (recipe == 3) {
+            if ((code - 1) % 3 == 2 || !IsRttAffixCompatible(target, code + 1, selectedSlot, level)) return false;
+            codes[selectedSlot] = code + 1;
+        } else {
+            std::array<uint8_t, 15> candidates {};
+            unsigned count = 0;
+            for (uint8_t candidate = 1; candidate <= 15; ++candidate) {
+                if (candidate == code || !IsRttAffixCompatible(target, candidate, selectedSlot, level)) continue;
+                bool duplicate = false;
+                for (size_t other = 0; other < codes.size(); ++other)
+                    if (other != selectedSlot && codes[other] != 0 && (codes[other] - 1) / 3 == (candidate - 1) / 3) duplicate = true;
+                if (!duplicate) candidates[count++] = candidate;
+            }
+            if (count == 0) return false;
+            codes[selectedSlot] = candidates[RttMix(target._iSeed + target.dwBuff + selectedSlot) % count];
+        }
+    }
+    Item metadata = target;
+    SetRttMetadata(metadata, RttItemRarity::Rare, codes);
+    if (metadata.dwBuff == target.dwBuff) return false;
+    Item rebuilt {};
+    RecreateItem(player, rebuilt, target.IDidx, target._iCreateInfo, target._iSeed, target._ivalue, metadata.dwBuff);
+    rebuilt._iIdentified = target._iIdentified;
+    rebuilt._iDurability = target._iDurability;
+    rebuilt._iMaxDur = target._iMaxDur;
+    rebuilt._iCharges = target._iCharges;
+    rebuilt._iMaxCharges = target._iMaxCharges;
+    rebuilt.position = target.position;
+    result = rebuilt;
+    return true;
+}
+
+bool RttCraftHeldRare(Player &player, unsigned recipe, unsigned slot)
+{
+    // The owning peer commits inventory mutations, as with the engine's stores.
+    // Gold and the eventual placement/drop use existing inventory network messages.
+    if (&player != MyPlayer || recipe < 2 || recipe > 4) return false;
+    constexpr std::array<int, 3> Costs { 100, 150, 50 };
+    const int cost = Costs[recipe - 2];
+    if (CalculateGold(player) < cost) return false;
+    Item result {};
+    if (!RttPrepareCraft(player, player.HoldItem, recipe, slot, result)) return false;
+    TakePlrsMoney(cost);
+    for (int index = 0; index < player._pNumInv; ++index)
+        if (player.InvList[index]._itype == ItemType::Gold) NetSyncInvItem(player, index);
+    player.HoldItem = result;
+    CalcPlrInv(player, true);
+    return true;
+}
+
