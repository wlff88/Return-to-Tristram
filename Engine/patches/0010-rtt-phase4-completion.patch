+    Item result=a; EXPECT_FALSE(RttPrepareCraft(*MyPlayer,a,99,0,result)); Same(a,result);
+    EXPECT_FALSE(RttPrepareCraft(*MyPlayer,a,3,4,result)); Same(a,result);
