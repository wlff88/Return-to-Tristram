+// Named item identity codes are append-only and independent of TSV row indices.
+// Zero remains the legacy Phase 4 encoding and is decoded by equipment kind.
+uint8_t RttNamedIdentity(const Item &item)
+{
+    const auto rarity = GetRttItemRarity(item);
+    const uint8_t code = GetRttAffixCode(item, 1);
+    if (rarity == RttItemRarity::Set) {
+        if ((code == 61 || code == 0) && item.isShield()) return 61;
+        if ((code == 62 || code == 0) && item._itype == ItemType::LightArmor) return 62;
+    }
+    if (rarity == RttItemRarity::Unique) {
+        if ((code == 60 || code == 0) && item._itype == ItemType::Staff) return 60;
+        if ((code == 61 || code == 0) && item.isShield()) return 61;
+        if ((code == 62 || code == 0) && item._itype == ItemType::LightArmor) return 62;
+    }
+    return 0;
+}
