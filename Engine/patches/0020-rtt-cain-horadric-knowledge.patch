+// RTT: identifies every unidentified item in the player's inventory (equipped + backpack)
+// in one action, charging the sum of each item's individual identify cost. Mirrors
+// StorytellerIdentifyItem's single-item logic, just batched.
+void RttIdentifyAllItems()
+{
+	Player &myPlayer = *MyPlayer;
+
+	int totalCost = 0;
+	for (Item &item : myPlayer.InvBody)
+		if (!item.isEmpty() && !item._iIdentified)
+			totalCost += item._iIvalue;
+	for (int i = 0; i < myPlayer._pNumInv; i++) {
+		Item &item = myPlayer.InvList[i];
+		if (!item.isEmpty() && !item._iIdentified)
+			totalCost += item._iIvalue;
+	}
+
+	if (totalCost == 0) {
+		EventPlrMsg(_("Nothing to identify."), UiFlags::ColorWhite);
+		return;
+	}
+
+	if (!PlayerCanAfford(totalCost)) {
+		StartStore(TalkID::NoMoney);
+		return;
+	}
+
+	for (Item &item : myPlayer.InvBody)
+		if (!item.isEmpty())
+			item._iIdentified = true;
+	for (int i = 0; i < myPlayer._pNumInv; i++)
+		myPlayer.InvList[i]._iIdentified = true;
+
+	TakePlrsMoney(totalCost);
+	CalcPlrInv(myPlayer, true);
+	EventPlrMsg(FormatRuntime(_("Identified everything for {:d} Gold."), totalCost), UiFlags::ColorWhitegold);
+}
+
+// RTT: Horadric Knowledge - Cain's gold-sink crafting-tier progression. Placeholder
+// costs/level gate per the Item UX/Salvage/Crafting design; must be purchased in order.
+// Level V additionally requires a character level for now (quest-completion gate
+// deferred until an actual quest system exists).
+constexpr std::array<int, 5> RttHoradricKnowledgeCosts { 5000, 20000, 60000, 150000, 400000 };
+constexpr std::array<const char *, 5> RttHoradricKnowledgeTierNames { "I", "II", "III", "IV", "V" };
+constexpr int RttHoradricKnowledgeLevelVCharLevel = 30;
+
+std::string RttHoradricKnowledgeOptionLabel()
+{
+	const Player &myPlayer = *MyPlayer;
+	const int nextTier = myPlayer.RttHoradricKnowledgeTier + 1;
+	if (nextTier > 5)
+		return "";
+	if (nextTier == 5 && myPlayer.getCharacterLevel() < RttHoradricKnowledgeLevelVCharLevel) {
+		return StrCat(_("Horadric Knowledge V (Requires Character Level "), RttHoradricKnowledgeLevelVCharLevel, ")");
+	}
+	return StrCat(_("Learn Horadric Knowledge "), RttHoradricKnowledgeTierNames[nextTier - 1],
+	    " (", RttHoradricKnowledgeCosts[nextTier - 1], " Gold)");
+}
+
+void RttPurchaseHoradricKnowledge()
+{
+	Player &myPlayer = *MyPlayer;
+	const int nextTier = myPlayer.RttHoradricKnowledgeTier + 1;
+	if (nextTier > 5)
+		return;
+	if (nextTier == 5 && myPlayer.getCharacterLevel() < RttHoradricKnowledgeLevelVCharLevel)
+		return;
+
+	const int cost = RttHoradricKnowledgeCosts[nextTier - 1];
+	if (!PlayerCanAfford(cost)) {
+		StartStore(TalkID::NoMoney);
+		return;
+	}
+
+	TakePlrsMoney(cost);
+	myPlayer.RttHoradricKnowledgeTier = static_cast<uint8_t>(nextTier);
+	EventPlrMsg(FormatRuntime(_("Learned Horadric Knowledge {:s}."), RttHoradricKnowledgeTierNames[nextTier - 1]), UiFlags::ColorWhitegold);
+}
