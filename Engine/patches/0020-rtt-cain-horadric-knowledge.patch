+namespace {
+
+constexpr uint8_t RttCraftingStateVersion = 1;
+constexpr char RttCraftingStateFileName[] = "rtt_crafting_state";
+
+} // namespace
+
+void LoadRttCraftingState(uint32_t saveNum, Player &player)
+{
+	player.RttHoradricKnowledgeTier = 0;
+
+	LoadHelper file(OpenSaveArchive(saveNum), RttCraftingStateFileName);
+	if (!file.IsValid())
+		return;
+
+	const uint8_t version = file.NextLE<uint8_t>();
+	if (version != RttCraftingStateVersion)
+		return;
+
+	const uint8_t tier = file.NextLE<uint8_t>();
+	if (tier <= 5)
+		player.RttHoradricKnowledgeTier = tier;
+}
+
+void SaveRttCraftingState(SaveWriter &saveWriter, const Player &player)
+{
+	constexpr size_t FileSize = 2 * sizeof(uint8_t);
+	SaveHelper file(saveWriter, RttCraftingStateFileName, FileSize);
+
+	file.WriteLE<uint8_t>(RttCraftingStateVersion);
+	file.WriteLE<uint8_t>(player.RttHoradricKnowledgeTier);
+}
