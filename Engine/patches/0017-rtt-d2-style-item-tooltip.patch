+// Computes the size of RttComparisonInfoString and places it beside primaryBox (D2-style: the hovered
+// item's tooltip and the currently equipped item's tooltip are two independent, side-by-side boxes).
+Rectangle RttGetComparisonInfoRect(const Rectangle &primaryBox, int lineHeight, int textSpacing)
+{
+	const std::string txt = std::string(RttComparisonInfoString);
+	auto lines = SplitByChar(txt, '\n');
+	const GameFontTables font = GameFont12;
+	int maxW = 0;
+	for (const auto &line : lines) {
+		const int w = GetLineWidth(line, font, textSpacing, nullptr);
+		maxW = std::max(maxW, w);
+	}
+	const auto lineCount = 1 + static_cast<int>(c_count(RttComparisonInfoString.str(), '\n'));
+	const int totalH = lineCount * lineHeight;
+
+	constexpr int gap = 10;
+	int x = primaryBox.position.x + primaryBox.size.width + gap;
+	if (x + maxW + gap > GetScreenWidth())
+		x = primaryBox.position.x - gap - maxW;
+
+	return { { x, primaryBox.position.y }, { maxW, totalH } };
+}
