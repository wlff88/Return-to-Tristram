+namespace {
+// Marks an OBJ_MCIRCLE1 instance as an RTT waypoint rather than a vanilla
+// Chamber of Bone (Q_BETRAYER) circle, since both share the same _object_id
+// and can legitimately coexist on the same level. AddMagicCircle() never
+// touches _oVar1.
+constexpr int RttWaypointSentinel = 1;
+
+bool IsRttWaypointObject(const Object &object)
+{
+	return object._otype == OBJ_MCIRCLE1 && object._oVar1 == RttWaypointSentinel;
+}
+} // namespace
+
+bool RttIsWaypointLevel(int level)
+{
+	if (level == 0)
+		return true;
+	return level >= 2 && level <= 16 && level % 2 == 0;
+}
+
+void RttEnsureWaypointObject(Point anchor)
+{
+	if (!RttIsWaypointLevel(currlevel))
+		return;
+
+	// Scan for an already-placed waypoint rather than checking fixed
+	// positions near `anchor`: town's ViewPosition varies with which of its
+	// several fixed entrances the player used (see CreateTown()), and a
+	// dungeon level's differs between its up- and down-stairs (ENTRY_MAIN
+	// vs ENTRY_PREV), so `anchor` is not a stable position to search around
+	// across revisits -- only a stable *starting point* for a first
+	// placement. Once placed, normal per-level save/load state (the same
+	// mechanism every other deterministic object already relies on)
+	// preserves the object and this scan finds it, regardless of which
+	// entrance was used on a later visit.
+	for (int i = 0; i < ActiveObjectCount; ++i) {
+		if (IsRttWaypointObject(Objects[ActiveObjects[i]]))
+			return;
+	}
+
+	// Small offsets around the entry anchor (not the exact stairs/spawn tile
+	// itself, which is typically occupied or awkward to stand on).
+	static constexpr std::array<Displacement, 5> Offsets {
+		Displacement { 2, 0 }, Displacement { 0, 2 }, Displacement { -2, 0 },
+		Displacement { 0, -2 }, Displacement { 1, 1 }
+	};
+
+	for (const Displacement &offset : Offsets) {
+		const Point candidate = anchor + offset;
+		if (!InDungeonBounds(candidate))
+			continue;
+		// Deliberately not IsTileOccupied(): that also checks dMonster/
+		// dPlayer, which are live per-client state that need not match
+		// between host and clients at the instant each of them independently
+		// runs this level-load code. Every client must derive the exact same
+		// placement from the same seed-deterministic inputs (level geometry
+		// and other seed-placed objects) the way vanilla's InitObjects()
+		// already does, or the waypoint would end up on a different tile per
+		// client.
+		if (IsTileSolid(candidate) || IsObjectAtPosition(candidate))
+			continue;
+		Object *waypoint = AddObject(OBJ_MCIRCLE1, candidate);
+		if (waypoint != nullptr)
+			waypoint->_oVar1 = RttWaypointSentinel;
+		return;
+	}
+}
+
 bool UpdateTrapState(Object &trap)
 {
 	if (trap._oVar4 != 0)
@@ -4480,6 +4558,14 @@ void OperateObject(Player &player, Object &object)
 	case OBJ_SIGNCHEST:
 		OperateInnSignChest(player, object, sendmsg);
 		break;
+	case OBJ_MCIRCLE1:
+	case OBJ_MCIRCLE2:
+		// Vanilla Chamber of Bone (Q_BETRAYER) circles use the same
+		// _object_id and have no click behavior of their own; only react to
+		// the ones RttEnsureWaypointObject() tagged as RTT waypoints.
+		if (sendmsg && IsRttWaypointObject(object))
+			StartWaypointPanel();
+		break;
 	default:
 		break;
 	}
