+TEST_F(RttPhase4, WaypointLevelSelection)
+{
+    // Town plus every second dungeon floor: one waypoint per branch
+    // midpoint/end (Cathedral 2/4, Catacombs 6/8, Caves 10/12, Hell 14/16).
+    EXPECT_TRUE(RttIsWaypointLevel(0));
+    for (int level = 1; level <= 16; ++level) {
+        EXPECT_EQ(RttIsWaypointLevel(level), level % 2 == 0) << "level " << level;
+    }
+    EXPECT_FALSE(RttIsWaypointLevel(17));
+    EXPECT_FALSE(RttIsWaypointLevel(-1));
+}
+TEST_F(RttPhase4, EnsureWaypointObjectNoOpOffWaypointLevel)
+{
+    // RttEnsureWaypointObject() must short-circuit before touching any
+    // dungeon/object state on a level that isn't in the waypoint set --
+    // levels 1-16 that aren't in it don't have a generated layout in this
+    // headless test, so touching tile/object state here would be unsafe.
+    const uint8_t savedLevel = currlevel;
+    const int activeBefore = ActiveObjectCount;
+    currlevel = 3;
+    RttEnsureWaypointObject({ 0, 0 });
+    EXPECT_EQ(ActiveObjectCount, activeBefore);
+    currlevel = savedLevel;
 }
